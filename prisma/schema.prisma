generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("ADMIN")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Category {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String?
  imageAssetId String?
  displayOrder Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  imageAsset   MediaAsset? @relation("CategoryImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  menuItems    MenuItem[]

  @@index([active, displayOrder])
}

model MenuItem {
  id           String      @id @default(cuid())
  categoryId   String
  slug         String      @unique
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  oldPrice     Decimal?    @db.Decimal(10, 2)
  imageAssetId String?
  available    Boolean     @default(true)
  featured     Boolean     @default(false)
  active       Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageAsset   MediaAsset? @relation("MenuItemImage", fields: [imageAssetId], references: [id], onDelete: Restrict)

  @@index([categoryId, active, displayOrder])
  @@index([featured, active, available, displayOrder])
}

model RestaurantSettings {
  id           String      @id @default("default")
  hotelName    String
  currency     String
  menuEnabled  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model MediaAsset {
  id                 String               @id @default(cuid())
  provider           String
  storageKey         String               @unique
  publicUrl          String
  mimeType           String
  byteSize           Int
  width              Int?
  height             Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  categoryImages     Category[]           @relation("CategoryImage")
  menuItemImages     MenuItem[]           @relation("MenuItemImage")
}

// All Dini Hotel models use PostgreSQL's default public schema.
// The Neon-managed neon_auth schema is intentionally excluded.
